generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MasterUser {
  id                              String            @id @default(cuid())
  email                           String            @unique
  passwordHash                    String
  name                            String
  role                            MasterUserRole    @default(SUPPORT)
  assignedSchoolIds               String[]          @default([])
  isActive                        Boolean           @default(true)
  isSuperAdmin                    Boolean           @default(false)
  mfaEnabled                      Boolean           @default(false)
  mfaSecret                       String?
  mfaTempSecret                   String?
  mfaRecoveryCodeHashes           String[]          @default([])
  mfaRecoveryCodeGeneratedAt      DateTime?
  loginEmailOtpHash               String?
  loginEmailOtpExpiresAt          DateTime?
  loginEmailOtpAttempts           Int               @default(0)
  loginEmailOtpSentAt             DateTime?
  passwordChangeEmailOtpHash      String?
  passwordChangeEmailOtpExpiresAt DateTime?
  passwordChangeEmailOtpAttempts  Int               @default(0)
  passwordChangeEmailOtpSentAt    DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  auditLogs                       MasterAuthAudit[]
  schoolInvites                   SchoolInvite[]

  @@index([loginEmailOtpExpiresAt])
  @@index([passwordChangeEmailOtpExpiresAt])
}

model School {
  id                   String                @id @default(cuid())
  name                 String
  subdomain            String                @unique
  type                 SchoolType            @default(SECONDARY)
  plan                 PlanType              @default(DISCOVERY)
  status               SchoolStatus          @default(PENDING)
  city                 String?
  region               String?
  address              String?
  phone                String?
  email                String?
  logoUrl              String?
  subsystem            SchoolSubsystem       @default(FRANCOPHONE)
  educationType        EducationType         @default(GENERAL)
  ownership            SchoolOwnership       @default(PRIVATE_SECULAR)
   features             Json                  @default("{}")
   saturdaySchedule     Boolean               @default(true)
   contractEnd          DateTime?
   hasPEBSFrancophone   Boolean               @default(false)
   hasPEBSAnglophone    Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  templateCode         String?
  onboardingConfig     Json?
  sequences            AcademicSequence[]
  academicYears        AcademicYear[]
  activitiesLogs       ActivitiesLog[]
  announcements        Announcement[]
  attendances          Attendance[]
  classes              Class[]
  classCouncilSessions ClassCouncilSession[]
  classPromotions      ClassPromotion[]
  conversations        Conversation[]
  disciplineRecords    DisciplineRecord[]
  emailLogs            EmailLog[]
  exams                Exam[]
  expenses             Expense[]
  feePlans             FeePlan[]
  grades               Grade[]
  gradeFormulas        GradeFormula[]
  invoices             Invoice[]
  mentionRules         MentionRule[]
  notifications        Notification[]
  offlineQueue         OfflineQueue[]
  payments             Payment[]
  reportCards          ReportCard[]
  template             SchoolTemplate?       @relation(fields: [templateCode], references: [code])
  schoolConfig                SchoolConfig?
  invites                     SchoolInvite[]
  schoolSettings              SchoolSettings?
  schoolNotificationSettings  SchoolNotificationSettings?
  configurationForm    SchoolConfigurationForm?
  sections             Section[]
  smsLogs              SmsLog[]
  staffProfiles        StaffProfile[]
  studentPromotions    StudentPromotion[]
  subjects             Subject[]
  departments          Department[]
  subjectCoefficients    SubjectCoefficient[]
  classSubjectOverrides  ClassSubjectOverride[]
  timetables             Timetable[]
  timetableGridConfig  TimetableGridConfig?
  users                User[]
  submissions          Submission[]
  books                Book[]
  bookLoans            BookLoan[]
  ficheOrientations    FicheOrientation[]
  verifiableDocuments  VerifiableDocument[]
  broadcastLogs        BroadcastLog[]
  programmes           Programme[]
  cahierDeTexte        CahierDeTexte[]
  employeeFiles        EmployeeFile[]
  careerEvents         CareerEvent[]
  staffAttendances     StaffAttendance[]
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]
  missionOrders        MissionOrder[]
}

model SchoolInvite {
  id                String       @id @default(cuid())
  email             String
  schoolName        String
  token             String       @unique @default(cuid())
  plan              PlanType     @default(DISCOVERY)
  status            InviteStatus @default(PENDING)
  expiresAt         DateTime
  createdAt         DateTime     @default(now())
  schoolId          String?
  invitedByMasterId String?
  notes             String?
  school            School?      @relation(fields: [schoolId], references: [id])
  invitedByMaster   MasterUser?  @relation(fields: [invitedByMasterId], references: [id])
}

model SchoolConfig {
  id                    String           @id @default(cuid())
  schoolId              String           @unique
  ds1Weight             Float            @default(1)
  ds2Weight             Float            @default(1)
  compositionWeight     Float            @default(2)
  classTestWeight       Float            @default(30)
  terminalExamWeight    Float            @default(70)
  moderatorUserId       String?
  moderator             User?            @relation("SchoolModerator", fields: [moderatorUserId], references: [id])
  aiRiskThreshold       Int              @default(50)
  bulletinTemplate      BulletinTemplate @default(FR_SECONDARY)
  gradesPerTerm                    Int              @default(2)
  sequenceCalculationMode          String           @default("single")
  legalMaxContributionFirstCycle   Int              @default(7500)
  legalMaxContributionSecondCycle  Int              @default(10000)
  termsPerYear                     Int              @default(3)
  maxAbsences                      Int              @default(10)
  smsEnabled                       Boolean          @default(false)
  offlineModeEnabled               Boolean          @default(true)
  aiAlertsEnabled                  Boolean          @default(true)
  messageModeration                Boolean          @default(false)
  schoolLanguageMode               String           @default("francophone")
  attendanceLateAsAbsence          Boolean          @default(false)
  bulletinBlockOnUnpaidFees        Boolean          @default(false)
  councilPassMark                  Float            @default(10)
  passMark                         Float            @default(10)
  passwordMinLength                Int              @default(8)
  passwordRequireUpper             Boolean          @default(false)
  passwordRequireDigit             Boolean          @default(true)
  sessionTimeoutMin                Int              @default(60)
  updatedAt             DateTime         @updatedAt
  absenceAlertThreshold Int              @default(3)
  christmasBreakEnd     DateTime?
  christmasBreakStart   DateTime?
  easterBreakEnd        DateTime?
  easterBreakStart      DateTime?
  schoolYearStartDate   DateTime?
  yearEndDate           DateTime?
  school                School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolSettings {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  timezone  String   @default("Africa/Douala")
  locale    String   @default("fr-CM")
  currency  String   @default("XAF")
  lastBackupAt   DateTime?
  lastBackupFile String?
  logRetentionDays Int      @default(90)
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolNotificationSettings {
  id               String  @id @default(cuid())
  schoolId         String  @unique
  smsAbsences      Boolean @default(true)
  smsPayments      Boolean @default(true)
  smsBulletins     Boolean @default(true)
  emailDigestAdmin Boolean @default(false)
  smsLowBalance    Boolean @default(false)
  school           School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolConfigurationForm {
  id          String    @id @default(cuid())
  schoolId    String    @unique
  formData    Json      @default("{}")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model GradeFormula {
  id          String   @id @default(cuid())
  schoolId    String?
  sectionId   String?
  label       String
  evaluations Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  school      School?  @relation(fields: [schoolId], references: [id])
  section     Section? @relation(fields: [sectionId], references: [id])

  @@index([schoolId])
}

model MentionRule {
  id        String   @id @default(cuid())
  schoolId  String?
  sectionId String?
  rules     Json
  isDefault Boolean  @default(false)
  school    School?  @relation(fields: [schoolId], references: [id])
  section   Section? @relation(fields: [sectionId], references: [id])

  @@index([schoolId])
}

model User {
  id                   String                 @id @default(cuid())
  schoolId             String
  role                 UserRole
  email                String?
  phone                String?
  passwordHash              String?
  resetPasswordToken        String?   @unique
  resetPasswordTokenExpiry  DateTime?
  firstName            String
  lastName             String
  avatarUrl            String?
  isActive             Boolean                @default(true)
  refreshTokenVersion  Int                    @default(0)
  lastLogin            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  announcements        Announcement[]         @relation("AnnouncementAuthor")
  attendancesRecorded  Attendance[]           @relation("RecordedAttendances")
  attendancesAsTeacher Attendance[]           @relation("TeacherAttendances")
  attendancesAsStudent Attendance[]           @relation("StudentAttendances")
  councilDecisions     ClassCouncilDecision[] @relation("CouncilDecisionStudent")
  councilPresided      ClassCouncilSession[]  @relation("CouncilPresidedBy")
  disciplineDecided    DisciplineRecord[]     @relation("DisciplineDecidedBy")
  disciplineRecords    DisciplineRecord[]     @relation("StudentDiscipline")
  expensesCreated      Expense[]              @relation("CreatedExpenses")
  gradesRecorded       Grade[]                @relation("RecordedGrades")
  gradesAsStudent      Grade[]                @relation("StudentGrades")
  gradesValidated      Grade[]                @relation("ValidatedGrades")
  invoices             Invoice[]              @relation("StudentInvoices")
  moderatedMessages    Message[]              @relation("ModeratedMessages")
  moderatedSchoolConfigs SchoolConfig[]        @relation("SchoolModerator")
  sentMessages         Message[]              @relation("SentMessages")
  receivedMessages     MessageReadStatus[]
  parentProfile        ParentProfile?
  payments             Payment[]              @relation("StudentPayments")
  refundedPayments     Payment[]              @relation("RefundedPayments")
  reportCards          ReportCard[]           @relation("StudentReportCards")
  staffProfile         StaffProfile?
  studentProfile       StudentProfile?
  submissions          Submission[]           @relation("StudentSubmissions")
  teacherProfile       TeacherProfile?
  school               School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notifications          Notification[]      @relation("UserNotifications")
  notificationPreference NotificationPreference?
  offlineQueueItems      OfflineQueue[]      @relation("UserOfflineQueue")
  timetableSlots         TimetableSlot[]     @relation("TeacherSlots")
  promotionsAsStudent       StudentPromotion[]  @relation("PromotedStudent")
  promotionsDecided         StudentPromotion[]  @relation("PromotionDecidedBy")
  classesProfessorPrincipal Class[]             @relation("ClassProfessorPrincipal")
  bookLoans                 BookLoan[]          @relation("StudentBookLoans")
  ficheOrientations         FicheOrientation[]  @relation("studentFiches")
  ficheOrientationsConseille FicheOrientation[] @relation("conseillerFiches")
  teachingAssignments       TeachingAssignment[] @relation("TeacherAssignments")
  headedDepartments         Department[]         @relation("DepartmentHead")
  cahierDeTexte             CahierDeTexte[]      @relation("TeacherCahierDeTexte")
  employeeFile              EmployeeFile?        @relation("EmployeeFileUser")
  employeeCareerEvents      CareerEvent[]         @relation("EmployeeCareerEvents")
  staffAttendances          StaffAttendance[]     @relation("StaffAttendanceUser")
  employeeLeaveRequests     LeaveRequest[]        @relation("EmployeeLeaveRequests")
  leaveRequestsValidated    LeaveRequest[]        @relation("LeaveRequestValidator")
  employeeLeaveBalances     LeaveBalance[]        @relation("EmployeeLeaveBalance")
  employeeMissionOrders     MissionOrder[]        @relation("EmployeeMissionOrders")

  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId, role])
}

model StudentProfile {
  id                  String                      @id @default(cuid())
  userId              String                      @unique
  matricule           String?
  dateOfBirth         DateTime?
  gender              String?
  classId             String?
  exitYear            String?
  studentStatus       StudentStatus               @default(ACTIVE)
  healthScore         Int?                        @default(75)
  pebsFiliere         String?
  photoUrl            String?
  parents             ParentStudent[]
  class               Class?                      @relation(fields: [classId], references: [id])
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subGroupAssignments StudentSubGroupAssignment[]
  verifiableDocuments VerifiableDocument[]
}

model TeacherProfile {
  id                   String           @id @default(cuid())
  userId               String           @unique
  specialization       String[]
  supervisedSubjectIds String[]         @default([])
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherSubjects      TeacherSubject[]
}

model ParentProfile {
  id       String          @id @default(cuid())
  userId   String          @unique
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]
}

model ParentStudent {
  parentProfileId  String
  studentProfileId String
  parentProfile    ParentProfile  @relation(fields: [parentProfileId], references: [id])
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@id([parentProfileId, studentProfileId])
}

model Section {
  id            String          @id @default(cuid())
  schoolId      String
  name          String
  code          SectionLanguage
  gradingSystem GradingSystem   @default(OUT_OF_20)
  isActive      Boolean         @default(true)
  passmark      Float           @default(10)
  classes       Class[]
  feePlans      FeePlan[]
  gradeFormulas GradeFormula[]
  mentionRules  MentionRule[]
  reportCards   ReportCard[]
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfiles StaffProfile[]

  @@unique([schoolId, code])
}

model StaffProfile {
  id          String            @id @default(cuid())
  schoolId    String
  userId      String            @unique
  title       String
  sectionId   String?
  permissions StaffPermission[]
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section     Section?          @relation(fields: [sectionId], references: [id])
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model StaffPermission {
  id             String              @id @default(cuid())
  staffProfileId String
  permission     StaffPermissionType
  staffProfile   StaffProfile        @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, permission])
}

model SubjectCoefficient {
  id          String  @id @default(cuid())
  schoolId    String
  subjectId   String
  classLevel  String
  serieCode   String?
  coefficient Float
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id])

  @@unique([schoolId, subjectId, classLevel, serieCode])
  @@index([schoolId])
}

model ClassSubjectOverride {
  id          String  @id @default(cuid())
  schoolId    String
  classId     String
  subjectId   String
  coefficient Float
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@index([schoolId])
}

model BacCoefficient {
  id                String         @id @default(cuid())
  subjectName       String
  serie             String
  niveau            String         @default("TERMINALE")
  coefficient       Float
  groupe            Int            @default(1)
  templateCode      String         @default("__ALL__")
  source            String         @default("Arrêté N° 92/22 MINESEC du 17 Mars 2022")
  isOfficialMinesec Boolean        @default(true)
  template          SchoolTemplate @relation(fields: [templateCode], references: [code])

  @@unique([subjectName, serie, niveau, templateCode])
}

model SchoolTemplate {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  subsystem        SchoolSubsystem
  educationType    EducationType
  level            SchoolLevel
  ownership        SchoolOwnership   @default(PRIVATE_SECULAR)
  config           Json
  createdAt        DateTime          @default(now())
  schools          School[]
  cycleCoefficients  CycleCoefficient[]
  bacCoefficients    BacCoefficient[]
  anglophoneSubjectLoads AnglophoneSubjectLoad[]
}

model CycleCoefficient {
  id            String         @id @default(cuid())
  templateCode  String
  classLevel    String
  subjectName   String
  coefficient   Float
  weeklyPeriods Int?
  filiere       String         @default("FR_GENERAL")
  template      SchoolTemplate @relation(fields: [templateCode], references: [code])

  @@unique([templateCode, classLevel, subjectName, filiere])
}

model AnglophoneSubjectLoad {
  id            String         @id @default(cuid())
  templateCode  String
  classLevel    String         // "Form1"..."UpperSixth"
  subjectName   String
  coefficient   Int
  weeklyPeriods Int?
  filiere       String         @default("EN_GENERAL")
  template      SchoolTemplate @relation(fields: [templateCode], references: [code])

  @@unique([templateCode, classLevel, subjectName, filiere])
}

// ── P2 ──────────────────────────────────────────────────────────────────────

model OLevelSubject {
  id          String @id @default(cuid())
  subjectName String @unique
  examCode    String // code officiel GCE (0530, 0570, 0705…)
}

model ALevelSubject {
  id          String @id @default(cuid())
  subjectName String @unique
  examCode    String // code officiel GCE (9070, 9090…)
}

// ── P3 ──────────────────────────────────────────────────────────────────────

model AnglophoneStreamCombination {
  id            String @id @default(cuid())
  filiere       String // "A1", "A2", …, "S1", "S2", …
  type          String // "ARTS" | "SCIENCES"
  coreSubjects  Json   // matières obligatoires pour cette filière
  electiveGroup Json?  // groupes d'options au choix
  description   String?

  @@unique([filiere])
}

// ── P4 ──────────────────────────────────────────────────────────────────────

model OLevelGrade {
  id          String @id @default(cuid())
  grade       String @unique // "A", "B", "C", …
  minScore    Float
  maxScore    Float
  description String?
}

model ALevelGrade {
  id          String @id @default(cuid())
  grade       String @unique // "A", "B", "C", …
  minScore    Float
  maxScore    Float
  description String?
}

model AcademicYear {
  id          String             @id @default(cuid())
  schoolId    String
  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean            @default(false)
  status      AcademicYearStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  periods           AcademicPeriod[]
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams             Exam[]
  grades            Grade[]
  reportCards       ReportCard[]
  timetables        Timetable[]
  studentPromotions StudentPromotion[]
  classPromotions   ClassPromotion[]
  programmes        Programme[]
  cahierDeTexte     CahierDeTexte[]

  @@index([schoolId])
}

model AcademicPeriod {
  id                   String                @id @default(cuid())
  academicYearId       String
  name                 String
  type                 PeriodType            @default(TRIMESTER)
  orderIndex           Int
  startDate            DateTime
  endDate              DateTime
  isCurrent            Boolean               @default(false)
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sequences            AcademicSequence[]
  attendances          Attendance[]
  classCouncilSessions ClassCouncilSession[]
  reportCards          ReportCard[]
}

model AcademicSequence {
  id               String         @id @default(cuid())
  academicPeriodId String
  schoolId         String
  name             String
  type             SequenceType
  orderIndex       Int
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean        @default(false)
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grades           Grade[]

  @@unique([academicPeriodId, orderIndex])
  @@index([schoolId])
}

model Class {
  id                    String                @id @default(cuid())
  schoolId              String
  name                  String
  level                 String?
  sectionId             String?
  capacity              Int                   @default(40)
  createdAt             DateTime              @default(now())
  filiere               String?
  serie                 String?
  professorPrincipalId  String?               @unique
  attendances           Attendance[]
  school                School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section               Section?              @relation(fields: [sectionId], references: [id])
  professorPrincipal    User?                 @relation("ClassProfessorPrincipal", fields: [professorPrincipalId], references: [id])
  classCouncilSessions  ClassCouncilSession[]
  subGroups             ClassSubGroup[]
  exams                 Exam[]
  grades                Grade[]
  students              StudentProfile[]
  timetables            Timetable[]
  studentFromPromotions StudentPromotion[]    @relation("StudentFromClass")
  studentToPromotions   StudentPromotion[]    @relation("StudentToClass")
  fromPromotions        ClassPromotion[]      @relation("FromClass")
  toPromotions          ClassPromotion[]      @relation("ToClass")
  teachingAssignments   TeachingAssignment[]
  subjectOverrides      ClassSubjectOverride[]
  programmes            Programme[]
  cahierDeTexte         CahierDeTexte[]

  @@index([schoolId])
}

model Subject {
  id                     String                  @id @default(cuid())
  schoolId               String
  name                   String
  code                   String?
  coefficient            Float                   @default(1)
  hoursPerWeek           Int                     @default(2)
  createdAt              DateTime                @default(now())
  subjectType            SubjectType             @default(THEORETICAL)
  departmentId           String?
  exams                  Exam[]
  grades                 Grade[]
  attendances            Attendance[]
  reportCardSubjectLines ReportCardSubjectLine[]
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectCoefficients    SubjectCoefficient[]
  classSubjectOverrides  ClassSubjectOverride[]
  teacherSubjects        TeacherSubject[]
  timetableSlots         TimetableSlot[]
  teachingAssignments    TeachingAssignment[]
  department             Department?             @relation(fields: [departmentId], references: [id])
  programmes             Programme[]
  cahierDeTexte          CahierDeTexte[]

  @@index([schoolId])
}

model Department {
  id        String    @id @default(cuid())
  schoolId  String
  name      String
  color     String    @default("#6b7280")
  headId    String?   @unique

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  head      User?     @relation("DepartmentHead", fields: [headId], references: [id])
  subjects  Subject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherSubject {
  teacherProfileId String
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id])
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@id([teacherProfileId, subjectId])
}

model TeachingAssignment {
  id        String  @id @default(cuid())
  classId   String
  subjectId String
  teacherId String
  schoolId  String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([schoolId])
}

model Attendance {
  id               String           @id @default(cuid())
  schoolId         String
  studentId        String
  classId          String
  academicPeriodId String?
  date             DateTime
  status           AttendanceStatus @default(PRESENT)
  period           AttendancePeriod @default(MORNING)
  recordedById     String?
  subjectId        String?
  teacherId        String?
  isOfflineSync    Boolean          @default(false)
  syncedAt         DateTime?
  createdAt        DateTime         @default(now())
  academicPeriod   AcademicPeriod?  @relation(fields: [academicPeriodId], references: [id])
  class            Class            @relation(fields: [classId], references: [id])
  recordedBy       User?            @relation("RecordedAttendances", fields: [recordedById], references: [id])
  subject          Subject?         @relation(fields: [subjectId], references: [id])
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          User             @relation("StudentAttendances", fields: [studentId], references: [id])
  teacher          User?            @relation("TeacherAttendances", fields: [teacherId], references: [id])

  @@index([schoolId, classId, date])
  @@index([schoolId, studentId])
}

model Grade {
  id                   String                @id @default(cuid())
  schoolId             String
  studentId            String
  subjectId            String
  classId              String
  academicYearId       String
  sequenceId           String
  sequenceScore        Float?
  classTestScore       Float?
  terminalExamScore    Float?
  theoreticalScore     Float?
  practicalScore       Float?
  professionalAttitude Float?
  oralScore            Float?  // Score oral — primaire APC (composante Oral)
  selfDevelopmentScore Float?  // Savoir-être — primaire APC (composante Savoir-être)
  coefficient          Float                 @default(1)
  maxValue             Float                 @default(20)
  sequenceAverage      Float?
  validationStatus     GradeValidationStatus @default(DRAFT)
  validatedById        String?
  validatedAt          DateTime?
  rejectionReason      String?
  observation          String?
  isOfflineSync        Boolean               @default(false)
  syncedAt             DateTime?
  createdAt            DateTime              @default(now())
  recordedById         String?
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id])
