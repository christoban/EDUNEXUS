// ─── Module Onboarding Auto-Service Élèves ─────────────────────────────────

enum OnboardingStatus {
  DRAFT // squelette créé par l'établissement, lien pas encore envoyé
  LINK_SENT // lien envoyé, en attente de saisie
  SUBMITTED // formulaire rempli, matching en cours
  PENDING_VALIDATION // matching terminé, en attente de validation humaine
  VALIDATED // validé, compte en cours de création
  ACTIVATED // compte créé, email de config mot de passe envoyé
  REJECTED // rejeté par le responsable (doublon, erreur, etc.)
  EXPIRED // token expiré sans soumission
}

enum OnboardingRecipient {
  ELEVE
  PARENT
  LES_DEUX
}

enum OnboardingSource {
  IMPORT_MASSE // rentrée, via Excel/CSV — ne passe normalement pas par ce modèle
  AUTOSERVICE // nouvel arrivant en cours d'année, initié par l'établissement
  CONCOURS // issu d'un EntranceExamCandidate confirmé (CEP réussi)
}

model StudentOnboarding {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Squelette initial (rempli par l'établissement, ou généré depuis le concours)
  nomProvisoire    String
  classId          String? // suggestion, éditable jusqu'à validation — nullable comme StudentProfile.classId
  classe           Class?              @relation(fields: [classId], references: [id])
  contactEmail     String?
  contactTelephone String?
  recipientType    OnboardingRecipient @default(ELEVE)

  // Traçabilité de la source
  sourceType      OnboardingSource       @default(AUTOSERVICE)
  examCandidateId String? // rempli uniquement si sourceType = CONCOURS
  examCandidate   EntranceExamCandidate? @relation(fields: [examCandidateId], references: [id])

  // Token sécurisé
  token          String    @unique
  tokenExpiresAt DateTime
  tokenUsedAt    DateTime?

  // Données soumises par l'élève/parent (JSON flexible, validées ensuite)
  submittedData Json?
  submittedAt   DateTime?

  // Résultat du matching (réutilise normalizeForMatch/compareNames de stringSimilarity.ts)
  matchScore       Int? // pourcentage 0-100 — null si aucun candidat n'a passé le verrou date de naissance
  matchedStudentId String? // doublon potentiel détecté

  // Statut et validation
  status          OnboardingStatus @default(DRAFT)
  validatedById   String?
  validatedBy     User?            @relation(fields: [validatedById], references: [id])
  validatedAt     DateTime?
  rejectionReason String?

  // Référence légère vers le compte créé — pas de relation Prisma stricte, même pattern que
  // EntranceExamCandidate.studentProfileId (évite d'alourdir davantage StudentProfile).
  createdStudentId String?

  // Relances
  remindersSentCount Int       @default(0)
  lastReminderAt     DateTime?
  escalatedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@index([token])
}

model SchoolOnboardingSettings {
  schoolId              String              @id
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  selfServiceEnabled    Boolean             @default(false)
  defaultRecipient      OnboardingRecipient @default(ELEVE)
  ageThresholdForParent Int                 @default(15) // en dessous de cet âge → formulaire au parent
  tokenExpiryDays       Int                 @default(14)
  reminderDelayDays     Int[]               @default([3, 7]) // jours après envoi pour chaque relance
  escalationDelayDays   Int                 @default(10)
  responsableRole       UserRole            @default(ADMIN) // UserRole existant : ADMIN ou STAFF
}

// ─────────────────────────────────────────────────────────────────────────
// Interopérabilité statistique MINESEC — génération du questionnaire officiel
// DPPC (1-DPPC-MINESEC-SECONDAIRE-2022.xls) à partir des données déjà saisies.
// Principe non négociable : on écrit dans une copie du vrai fichier téléchargé
// depuis minesec.gov.cm, on ne recrée jamais un fac-similé. Voir
// spec-minesec-interoperabilite.md pour le détail des catégories A/B/C.
// ─────────────────────────────────────────────────────────────────────────

model StatisticalCampaignTemplate {
  id            String                  @id @default(cuid())
  ministry      String // "MINESEC" (seul ministère couvert pour l'instant — voir doc section 4 pour MINEDUB)
  year          String // campagne de référence, ex. "2022" (suffixe du fichier officiel)
  fileName      String // nom du fichier stocké (copie protégée du .xls original)
  filePath      String // chemin de stockage du template déchiffrable (jamais modifié directement)
  fileFormat    String                  @default("XLS_LEGACY_BIFF8")
  isActive      Boolean                 @default(true) // un seul template actif par ministère à la fois
  uploadedAt    DateTime                @default(now())
  fieldMappings CampaignFieldMapping[]
  submissions   StatisticalSubmission[]

  @@index([ministry, isActive])
}

model CampaignFieldMapping {
  id               String                      @id @default(cuid())
  templateId       String
  template         StatisticalCampaignTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sheetName        String // ex. "Eleves_ESG_Fr"
  fieldCode        String // code officiel DPPC, ex. "2100" — jamais de position de cellule brute comme clé
  fieldLabel       String // libellé FR tel qu'affiché dans le fichier, pour le rapport d'accompagnement
  cellReference    String // ex. "R17" — cellule où écrire la valeur résolue
  dataType         String                      @default("NUMBER") // "NUMBER" | "TEXT" | "BOOLEAN"
  category         MappingCategory
  zekoulabiaSource String? // description technique de la résolution (ex. "StudentProfile.lv2SubjectId=ESP_ID"), null si C_MANUAL

  @@unique([templateId, fieldCode, cellReference])
  @@index([templateId, category])
}

enum MappingCategory {
  A_AUTO // dérivé automatiquement des données ZekoulABia (élèves, personnel, FeePlan)
  B_PARTIAL // dérivé si la donnée RH existe (EmployeeFile), sinon cellule vide + signalé
  C_MANUAL // saisi une fois dans SchoolStatisticalSupplement, vérifié à chaque campagne
}

model StatisticalSubmission {
  id                     String                      @id @default(cuid())
  schoolId               String
  school                 School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateId             String
  template               StatisticalCampaignTemplate @relation(fields: [templateId], references: [id])
  generatedAt            DateTime                    @default(now())
  generatedBy            String
  generatedByUser        User                        @relation(fields: [generatedBy], references: [id])
  status                 SubmissionStatus            @default(DRAFT)
  filePath               String? // null tant que status = PENDING_MANUAL_DATA (aucun fichier généré)
  unresolvedFieldsReport Json? // liste des champs B_PARTIAL non résolus (gap RH) — jamais inventé, toujours signalé

  @@index([schoolId, generatedAt])
}

enum SubmissionStatus {
  DRAFT
  PENDING_MANUAL_DATA
  REVIEWED
  SUBMITTED
}

// Faits administratifs qui changent rarement (superficie, titre foncier, historique BIP...).
// Saisis une fois par l'admin, vérifiés/ajustés à chaque nouvelle campagne — jamais ressaisis
// depuis zéro. Champs Json pour les structures répétitives (infrastructures par salle,
// historique BIP, effectifs techniques par spécialité) : saisie rare, pas besoin de la
// richesse relationnelle d'une vraie table pour ce cas d'usage.
model SchoolStatisticalSupplement {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Section Identification (Catégorie C — codes 1100-1200)
  hasTitreFoncier                   Boolean?
  siteProvisoire                    Boolean?
  distanceEtablissementProchePublic Float?
  superficieTerrainM2               Float?
  superficieExtensionM2             Float?
  natureVoiesAcces                  String?
  nombreCycles                      Int?
  hasInternat                       Boolean?
  placesInternatFilles              Int?
  placesInternatGarcons             Int?
  historiqueTransformations         Json? // liste [{type, annee}]
  ecolesPrimairesProximite          Json? // {moins1km, entre1et3km, entre4et5km, plus5km}
  posteComptable                    String?

  // Section Infrastructures (Catégorie C — codes 3100-3311), séparée par sous-système
  // (Général Francophone / Général Anglophone / Technique Francophone / Technique Anglophone)
  infrastructuresDetail Json?

  // Section Financement (Catégorie C — codes 6000-6010, historique BIP uniquement ;
  // les frais APE/inscription 6011-6023 sont Catégorie A, dérivés de FeePlan)
  historiqueBip Json? // liste [{designation, anneeObtention}]

  // Section effectifs techniques ESTP (Catégorie C intégrale pour cette phase — pas de
  // correspondance fiable entre les ~12 filières internes EduNexus et les 100+ spécialités
  // officielles MINESEC, voir CampaignFieldMapping catégorie C pour Eleves_ESTP_Fr/Atelier_Workshop)
  effectifsTechniquesDetail Json? // liste [{specialiteAcronyme, anneeEtude, divisions, fillesTotal, garconsTotal, fillesRedoublants, garconsRedoublants}]
  ateliersDetail            Json? // liste [{atelier, etat, equipements: [{designation, quantite, etat}], nombrePostesTravail}]

  lastUpdatedAt DateTime @updatedAt
  lastUpdatedBy String
}

// ─────────────────────────────────────────────────────────────────────────
// Interopérabilité statistique MINEDUB (préscolaire/primaire) — voir
// spec-minedub-interoperabilite.md. Contrairement à MINESEC, aucun
// questionnaire officiel téléchargeable n'existe : on produit un RAPPORT PDF
// DE SYNTHÈSE (jamais présenté comme un document officiel), reconstitué à
// partir des Annuaires Statistiques MINEDUB publiés. Pas de blocage strict
// à la génération (contrairement à MINESEC) : les champs manquants sont
// listés directement dans le rapport imprimable, qui reste un support de
// préparation avant saisie du vrai questionnaire papier remis par l'IAEB.
// ─────────────────────────────────────────────────────────────────────────

model MinedubSchoolSupplement {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  zoneImplantation  String? // "URBAINE" | "RURALE"
  ordreEnseignement String? // "PUBLIC" | "PRIVE_CATHOLIQUE" | "PRIVE_PROTESTANT" | "PRIVE_ISLAMIQUE" | "PRIVE_LAIC" | "COMMUNAUTAIRE"

  // Élèves vulnérables — comptage global déclaratif (aucun champ par élève dans
  // StudentProfile), par niveau et sexe : { "CP": { refugiesF, refugiesG, deplacesF,
  // deplacesG, handicapesF, handicapesG }, ... }
  elevesVulnerablesDetail Json?

  // Infrastructures — Dur/Semi-dur/Provisoire × Bon/Assez bon/Mauvais (3×3, différent
  // de MINESEC qui n'a que 2 matériaux). { "sallesClasseOccupees": { durBon, durAssezBon,
  // durMauvais, semiDurBon, ... }, ... }
  infrastructuresDetail Json?

  commoditesDetail Json? // { pointEau: bool, latrines: nombre, electricite: bool, ... }
  manuelsDetail    Json? // { "CP": { manuelsEleves, manuelsEnseignants }, ... } par niveau

  lastUpdatedAt DateTime @updatedAt
  lastUpdatedBy String
}

model MinedubStatisticalReport {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  generatedAt      DateTime @default(now())
  generatedBy      String
  generatedByUser  User     @relation("MinedubReportGeneratedBy", fields: [generatedBy], references: [id])
  filePath         String
  champsNonResolus Json? // liste des champs non résolus au moment de la génération, pour audit

  @@index([schoolId, generatedAt])
}
