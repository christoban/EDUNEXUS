// ── Module Orientation ──────────────────────────────────────────────────────

enum OrientationStatus {
  OUVERTE
  EN_COURS
  CLOSE
  TRANSFEREE
}

enum NiveauRisque {
  FAIBLE
  MOYEN
  ELEVE
  CRITIQUE
}

enum TypePreoccupation {
  SCOLAIRE
  COMPORTEMENTAL
  FAMILIAL
  PROFESSIONNEL
  SANTE
  AUTRE
}

enum TypeEntretien {
  INDIVIDUEL
  GROUPE
  AVEC_PARENT
}

enum MotifEntretien {
  ORIENTATION_GENERALE
  DIFFICULTE_SCOLAIRE
  CHOIX_FILIERE_BAC
  PROJET_PROFESSIONNEL
  PROBLEME_COMPORTEMENT
  DEMANDE_ELEVE
  DEMANDE_PARENT
  DEMANDE_ENSEIGNANT
}

enum StatutEntretien {
  PLANIFIE
  REALISE
  ANNULE
  REPORTE
}

enum TypeTest {
  COGNITIF
  INTERETS_PROFESSIONNELS
  PERSONNALITE
  PSYCHOTECHNIQUE
}

enum StatutRecommandation {
  PROPOSEE
  VALIDEE_ADMIN
  ACCEPTEE_PARENT
  REFUSEE_PARENT
  TRANSMISE_DRES
}

model FicheOrientation {
  id              String                @id @default(cuid())
  studentId       String
  schoolId        String
  academicYearId  String
  conseillerId    String
  status          OrientationStatus     @default(OUVERTE)
  riskLevel       NiveauRisque          @default(FAIBLE)
  mainConcern     TypePreoccupation?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  student         User                  @relation("studentFiches", fields: [studentId], references: [id])
  school          School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conseillerStaff User                  @relation("conseillerFiches", fields: [conseillerId], references: [id])
  entretiens      EntretienOrientation[]
  tests           TestAptitude[]
  recommandation  RecommandationSerie?
  suivis          SuiviOrientation[]

  @@unique([studentId, academicYearId])
  @@index([schoolId, status])
  @@index([schoolId, riskLevel])
}

model EntretienOrientation {
  id                 String           @id @default(cuid())
  ficheOrientationId String
  date               DateTime
  type               TypeEntretien
  motif              MotifEntretien
  notes              String?
  recommendations    String?
  nextActions        String?
  parentNotified     Boolean          @default(false)
  followUpDate       DateTime?
  status             StatutEntretien  @default(PLANIFIE)
  createdAt          DateTime         @default(now())
  fiche              FicheOrientation @relation(fields: [ficheOrientationId], references: [id], onDelete: Cascade)

  @@index([ficheOrientationId])
}

model TestAptitude {
  id                 String           @id @default(cuid())
  ficheOrientationId String
  type               TypeTest
  datePassage        DateTime
  resultats          String
  interpretation     String?
  scoreGlobal        Int?
  createdAt          DateTime         @default(now())
  fiche              FicheOrientation @relation(fields: [ficheOrientationId], references: [id], onDelete: Cascade)

  @@index([ficheOrientationId])
}

model RecommandationSerie {
  id                 String               @id @default(cuid())
  ficheOrientationId String               @unique
  studentId          String
  serieActuelle      String
  serieRecommandee   String
  justification      String
  parentNotified     Boolean              @default(false)
  adminValidated     Boolean              @default(false)
  status             StatutRecommandation @default(PROPOSEE)
  createdAt          DateTime             @default(now())
  fiche              FicheOrientation     @relation(fields: [ficheOrientationId], references: [id], onDelete: Cascade)
}

model SuiviOrientation {
  id                 String            @id @default(cuid())
  ficheOrientationId String
  date               DateTime          @default(now())
  riskLevel          NiveauRisque
  mainConcern        TypePreoccupation
  interventions      String?
  prochainRdv        DateTime?
  notes              String?
  fiche              FicheOrientation  @relation(fields: [ficheOrientationId], references: [id], onDelete: Cascade)

  @@index([ficheOrientationId])
}

// ── Documents vérifiables (certificats, cartes, bulletins) ───────────────────

enum VerifiableDocumentType {
  CERTIFICATE
  STUDENT_CARD
  TRANSFER_LETTER
  REPORT_CARD
}

model VerifiableDocument {
  id               String                 @id @default(cuid())
  type             VerifiableDocumentType
  studentId        String
  schoolId         String
  generatedAt      DateTime               @default(now())
  dataSnapshot     Json
  student          StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school           School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([schoolId])
}

// ── Bibliothèque ─────────────────────────────────────────────────────────────

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

model Book {
  id        String     @id @default(cuid())
  schoolId  String
  title     String
  author    String?
  isbn      String?
  quantity  Int        @default(1)
  available Int        @default(1)
  category  String?
  createdAt DateTime   @default(now())
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loans     BookLoan[]

  @@index([schoolId])
}

model BookLoan {
  id         String     @id @default(cuid())
  schoolId   String
  bookId     String
  studentId  String
  borrowedAt DateTime   @default(now())
  dueDate    DateTime?
  returnedAt DateTime?
  status     LoanStatus @default(ACTIVE)
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book       Book       @relation(fields: [bookId], references: [id])
  student    User       @relation("StudentBookLoans", fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([bookId])
}

// ── Pédagogie ─────────────────────────────────────────────────────────────────

model Programme {
  id             String       @id @default(cuid())
  schoolId       String
  subjectId      String
  classId        String?
  level          String?
  academicYearId String
  titre          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class          Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  chapitres      Chapitre[]

  @@index([schoolId])
  @@index([subjectId])
  @@index([academicYearId])
}

model Chapitre {
  id                   String          @id @default(cuid())
  programmeId          String
  titre                String
  ordre                Int
  volumeHeuresPrevu    Int             @default(2)
  sequenceCibleFin     Int?
  createdAt            DateTime        @default(now())
  programme            Programme       @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  cahierDeTexteEntries CahierDeTexte[]

  @@index([programmeId])
}

model CahierDeTexte {
  id             String       @id @default(cuid())
  schoolId       String
  teacherId      String
  classId        String
  subjectId      String
  academicYearId String
  chapitreId     String?
  date           DateTime     @default(now())
  contenuRealise String?
  contenuLibre   String?
  devoirsDonnes  String?
  createdAt      DateTime     @default(now())
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher        User         @relation("TeacherCahierDeTexte", fields: [teacherId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  chapitre       Chapitre?    @relation(fields: [chapitreId], references: [id])

  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([academicYearId])
}
